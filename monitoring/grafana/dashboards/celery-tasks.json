{
  "uid": "iso-celery-tasks",
  "title": "ISO Robot - Task Execution",
  "tags": ["iso-robot", "celery", "tasks"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Task Throughput",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum(rate(celery_tasks_total[5m])) by (task, status)", "legendFormat": "{{task}} {{status}}", "refId": "A"}
      ],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 2,
      "title": "Task Duration p95",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(celery_task_duration_seconds_bucket[5m])) by (le, task))", "legendFormat": "{{task}}", "refId": "A"}
      ],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 3,
      "title": "Task Failures",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "sum(rate(celery_tasks_failed_total[5m])) by (task)", "legendFormat": "{{task}}", "refId": "A"}
      ],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 4,
      "title": "Task Retries",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "sum(rate(celery_task_retries_total[5m])) by (task)", "legendFormat": "{{task}}", "refId": "A"}
      ],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    }
  ]
}
