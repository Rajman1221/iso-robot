# Copy to .env before: docker compose up --build
# Azure keys are optional if USE_LLM_FALLBACK=true (default).

# API_PORT=8000
# DOCS_PORT=3005
# LOG_LEVEL=INFO
# RUN_SEED_DEMO=true

# DATABASE_PATH=/app/backend/data/db.sqlite
# Per-org uploads live beside the DB: {dirname(DATABASE_PATH)}/org_documents/{org_slug}/...
# On a VM without Docker, e.g. DATABASE_PATH=/home/ubuntu/iso-robot/backend/data/db.sqlite
# DOCUMENTS_DIR=/app/all-docs

# ── Auth ──────────────────────────────────────────────────────────────────────
# ISO Robot is the identity provider: client backends call POST /auth/login to get
# a token, send it as `Authorization: Bearer <token>` on every request, and (if
# they guard their own resources) call POST /auth/verify to introspect it.
# JWT_SECRET_KEY=change-me-in-production   # HMAC secret that signs every token
# JWT_IDLE_MINUTES=86400                     # sliding-window token lifetime (default: 60 days)
#
# AUTH_MODE=self   # "self" (default): we issue AND validate the token everywhere,
#                  #   including /ingest and /pipeline/*. Zero external calls.
#                  # "external": legacy — the pipeline APIs instead forward the
#                  #   caller's token to VERIFY_API_URL (see block below).
#
# Token introspection (POST /auth/verify) — give each client backend one shared key;
# it must send it as the X-Api-Key header. Comma-separated. Empty = no key (dev only).
# AUTH_INTROSPECTION_KEYS=client-a-key,client-b-key

# ── Automated pipeline persistence (DB-agnostic SQLAlchemy async ORM) ──────────
# Empty DB_URI falls back to the sqlite file at DATABASE_PATH (fine for a single
# worker / low volume). For real Celery worker concurrency, point this at Postgres
# or MySQL instead — it's the ONE value that moves the whole app between databases.
# DB_URI=postgresql+asyncpg://iso_robot:iso_robot@postgres:5432/iso_robot
# DB_URI=mysql+aiomysql://iso_robot:iso_robot@mysql:3306/iso_robot
# DB_POOL_SIZE=10
# DB_POOL_MAX_OVERFLOW=20

# Local Postgres service (docker-compose `postgres`) — only used if DB_URI above
# points at it; the service always starts so it's ready when you switch over.
# POSTGRES_USER=iso_robot
# POSTGRES_PASSWORD=iso_robot
# POSTGRES_DB=iso_robot
# POSTGRES_PORT=5432

# ── Automated pipeline (Celery workers + RabbitMQ broker + Redis result backend) ──
# Service hostnames below are the docker-compose service names (rabbitmq, redis).
# RABBITMQ_USER=iso_robot
# RABBITMQ_PASSWORD=iso_robot
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672        # http://localhost:15672 (same user/pass)
# CELERY_BROKER_URL=amqp://iso_robot:iso_robot@rabbitmq:5672//
# CELERY_RESULT_BACKEND=redis://redis:6379/0
# REDIS_PORT=6379
# CELERY_TASK_ALWAYS_EAGER=false        # true only for tests — never in production
# CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=7200   # 2h soft limit (classify_issues on large docs)
# CELERY_TASK_TIME_LIMIT_SECONDS=7500        # hard kill; must exceed soft limit

# PIPELINE_SAVE_TO_STORAGE_DEFAULT=false  # default for POST /ingest when the caller omits save_to_storage
# Docker Compose sets this automatically on api + workers (shared ./backend/data mount):
# PIPELINE_INGEST_TEMP_DIR=/app/backend/data/ingest-tmp
# For local non-Docker runs, leave empty to use the OS temp dir (single-process only).

# External backend verification — ONLY used when AUTH_MODE=external (legacy).
# ISO Robot forwards the caller's existing-backend token to this endpoint to
# verify the user before starting the pipeline. Leave unset in the default
# (self) mode; ISO Robot validates its own token there.
# VERIFY_API_URL=https://existing-backend.example.com/api/verify
# VERIFY_API_KEY=                       # optional; sent as X-Api-Key header
# VERIFY_API_TIMEOUT_SECONDS=10
# EXTERNAL_AUTH_CACHE_MINUTES=30        # sliding cache after a successful verify
# VERIFY_API_VALID_FIELD=               # optional response field asserting validity, e.g. isValid
# VERIFY_API_VALID_VALUE=               # optional expected value for the field above
# VERIFY_MOCK=false 
                    # true = skip the verify HTTP call (dev/test only; never in prod)

# ── Observability (Prometheus + Grafana + Tempo + Loki) ───────────────────────
# OBSERVABILITY_ENABLED=true
# LOG_JSON=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
# OTEL_SERVICE_NAME=iso-robot-api
# METRICS_PORT=9808
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
# TEMPO_HTTP_PORT=3200
# TEMPO_OTLP_GRPC_PORT=4317
# LOKI_PORT=3100
# RABBITMQ_PROMETHEUS_PORT=15692
# CELERY_EXPORTER_PORT=9809
# WORKER_ORCHESTRATOR_METRICS_PORT=9810
# WORKER_EXTRACT_METRICS_PORT=9811
# WORKER_LLM_METRICS_PORT=9812
# WORKER_SCORING_METRICS_PORT=9813
# CADVISOR_PORT=8080
# NODE_EXPORTER_PORT=9100

# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# AZURE_DOCUMENT_INTELLIGENCE_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure OpenAI embedding deployment, e.g. text-embedding-3-small (1536-dim).
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# AZURE_OPENAI_EMBEDDING_DIM=1536

# Milvus vector DB
# In Docker Compose the API reaches Milvus at the service hostname below.
# MILVUS_URI=http://milvus-standalone:19530
# MILVUS_TOKEN=
# MILVUS_DB_NAME=default
# MILVUS_COLLECTION=iso_robot_knowledge

# Chatbot retrieval (optional tuning)
# CHATBOT_TOP_K=8
# CHATBOT_MAX_CONTEXT_CHARS=12000
