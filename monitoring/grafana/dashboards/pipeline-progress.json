{
  "uid": "iso-pipeline-progress",
  "title": "ISO Robot - Pipeline Progress",
  "tags": ["iso-robot", "pipeline"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Active Pipeline Runs",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum(pipeline_active_runs)", "refId": "A"}
      ],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 2,
      "title": "Run Progress %",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [
        {"expr": "pipeline_run_progress_percent", "legendFormat": "{{pipeline_run_id}} ({{current_stage}})", "refId": "A"}
      ],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 3,
      "title": "Run Duration (seconds)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [
        {"expr": "pipeline_run_duration_seconds", "legendFormat": "{{pipeline_run_id}}", "refId": "A"}
      ],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 4,
      "title": "Estimated Remaining (seconds)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "targets": [
        {"expr": "pipeline_run_estimated_remaining_seconds", "legendFormat": "{{pipeline_run_id}}", "refId": "A"}
      ],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 5,
      "title": "Documents Processed",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "targets": [
        {"expr": "sum(rate(pipeline_documents_processed_total[5m])) by (status)", "legendFormat": "{{status}}", "refId": "A"}
      ],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    }
  ]
}
